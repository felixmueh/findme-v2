# Copy to `.env` (git-ignored) and adjust. Docker Compose reads `.env` from the
# directory of compose.yaml. Relative paths are relative to that directory.

# Host port the app is served on.
FINDME_PORT=48317

# Host directory for the SQLite database, search corpus and thumbnails.
FINDME_DATA=./data

# Host directory with your images, video and audio. Mounted read-only.
FINDME_MEDIA=./media

# Where the media folder appears inside the container. Set the source `root`
# in your config to this path. Setting it to the same path as FINDME_MEDIA
# makes "copy absolute path" in the app return paths that work on the host.
FINDME_MEDIA_MOUNT=/assets

# Your app config, copied from config/findme.example.toml.
FINDME_CONFIG=./config/findme.local.toml
